#version 460

layout(
    local_size_x = 8,
    local_size_y = 8,
    local_size_z = 1
) in;


layout(
    set = 0,
    binding = 0
)
uniform sampler2D hudlessImage;


layout(
    set = 0,
    binding = 1
)
uniform sampler2D finalImage;


layout(
    set = 0,
    binding = 2,
    r32f
)
writeonly uniform image2D uiAlphaImage;


void main()
{
    ivec2 p =
        ivec2(
            gl_GlobalInvocationID.xy
        );


    ivec2 size =
        imageSize(
            uiAlphaImage
        );


    if(
        p.x >= size.x ||
        p.y >= size.y
    )
    {
        return;
    }


    vec3 hudlessColor =
        texelFetch(
            hudlessImage,
            p,
            0
        ).rgb;


    vec3 finalColor =
        texelFetch(
            finalImage,
            p,
            0
        ).rgb;


    vec3 diff = abs(finalColor - hudlessColor);
    float maxDiff = max(diff.r, max(diff.g, diff.b));

    // 2026-11-25 Batch P: Ignore subtle <= 3/255 full-screen overlays or 8-bit
    // quantization differences so they never freeze DLSS Frame Generation across
    // large screen regions, while crisp HUD/text/crosshair/hand (>= 10/255) keep
    // full 1.0 static UI protection.
    float alpha = smoothstep(3.0 / 255.0, 10.0 / 255.0, maxDiff);


    imageStore(
        uiAlphaImage,
        p,
        vec4(
            alpha,
            0.0,
            0.0,
            1.0
        )
    );
}