#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
// 链路本体在 rr_post_common.glsl（与 rr_hdr_encode.comp 共用）。
#include "rr_post_common.glsl"

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(rrOutputImage);

    if(p.x >= size.x || p.y >= size.y)
    {
        return;
    }

    vec4 color = imageLoad(rrOutputImage, p);

    vec3 exposedLinear;
    vec3 displayColor = rrPostDisplayColor(color, p, size, exposedLinear);

    // 2026-11-26：去色带抖动与 clamp 移出 cgActive 分支。
    // 批次 O 把抖动写进了 `if(cgActive)`，而默认调色参数全为 0 ⇒ cgActive 恒假，
    // 抖动从未执行过（雾 / 暗部 / 夜空色带照旧）。抖动对任何档位都应生效。
    displayColor += sdrTriangularDither(uvec2(p));
    displayColor = clamp(displayColor, vec3(0.0), vec3(1.0));

    imageStore(
        rrOutputImage,
        p,
        vec4(displayColor, color.a)
    );
}
