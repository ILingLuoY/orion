#version 460


layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PostPush
{
    int tonemapMode;
    float exposureStrength;
    float contrast;
    float saturation;
    float gamma;
    float gainR;
    float gainG;
    float gainB;

    float manualEV;
    float blackPoint;
    float whitePoint;
    float gradeContrast;
    float gradePivot;
    float liftR;
    float liftG;
    float liftB;
    float gradeGammaR;
    float gradeGammaG;
    float gradeGammaB;
    float gradeGainR;
    float gradeGainG;
    float gradeGainB;
    float shadowHue;
    float shadowStrength;
    float highlightHue;
    float highlightStrength;
    float vibrance;
    float fade;
    float vignette;
    float vignetteRadius;
    float hueRotate;
    float tintGreen;
} postPush;
#ifndef RR_STABLE_GLASS_RADIANCE
#define RR_STABLE_GLASS_RADIANCE 0
#endif

layout(binding = 0, set = 0, rgba16f)
uniform image2D rrOutputImage;

#if RR_STABLE_GLASS_RADIANCE
layout(binding = 2, set = 0)
uniform sampler2D rrStableRadianceImage;
#endif

layout(binding = 1, set = 0)
buffer AeState
{
    float currentEV;
    float targetEV;
    float avgLogLuma;
    uint sampleCount;
    float cloudWhite;
};

layout(binding = 3, set = 0)
uniform sampler3D aces2Lut3D;

// ---------------------------------------------------------------------------
// mode 0: Uchimura 2017（= 社区所谓 GT tonemap；本曲线即 Polyphony 官方口径）。
// 注意：与旧实现不同，这里**不做**内建 gamma —— 统一由最后的 gamma 阶段处理
//（默认 2.2 时与旧的内建 1/2.2 逐位一致）。
// ---------------------------------------------------------------------------
vec3 sdrTriangularDither(uvec2 pixel)
{
    const vec2 pf = vec2(pixel);
    const float r0 = fract(52.9829189 * fract(dot(pf, vec2(0.06711056, 0.00583715))));
    const float r1 = fract(52.9829189 * fract(dot(pf + vec2(17.0, 31.0), vec2(0.06711056, 0.00583715))));
    const float g0 = fract(52.9829189 * fract(dot(pf + vec2(5.0, 11.0), vec2(0.06711056, 0.00583715))));
    const float g1 = fract(52.9829189 * fract(dot(pf + vec2(23.0, 41.0), vec2(0.06711056, 0.00583715))));
    const float b0 = fract(52.9829189 * fract(dot(pf + vec2(13.0, 7.0), vec2(0.06711056, 0.00583715))));
    const float b1 = fract(52.9829189 * fract(dot(pf + vec2(37.0, 19.0), vec2(0.06711056, 0.00583715))));
    return vec3(r0 - r1, g0 - g1, b0 - b1) * (0.5 / 255.0);
}

vec3 uchimura(vec3 x)
{
    const float P = 1.0;
    const float a = max(postPush.contrast, 1.0e-3);
    const float m = 0.22;
    const float l = 0.4;
    const float c = 1.33;
    const float b = 0.0;

    float l0 = ((P - m) * l) / a;
    float S0 = m + l0;
    float S1 = m + a * l0;
    float C2 = (a * P) / (P - S1);
    float CP = -1.44269502 * C2 / P;

    vec3 w0 = vec3(1.0 - smoothstep(0.0, m, x));
    vec3 w2 = vec3(step(S0, x));
    vec3 w1 = vec3(1.0 - w0 - w2);

    vec3 T = pow(x, vec3(c)) / pow(m, c - 1.0) + vec3(b);
    vec3 S = vec3(P - (P - S1) / exp2(CP * S0) * exp2(CP * x));
    vec3 L = vec3(m + a * (x - m));

    return T * w0 + L * w1 + S * w2;
}

// ---------------------------------------------------------------------------
// mode 1: AgX（minimal 版；Troy Sobotka 的 AgX 经 Benjamin Wrensch 压缩的
// 广泛复刻实现）。输入输出都是线性。
// ---------------------------------------------------------------------------
vec3 agxDefaultContrastApprox(vec3 x)
{
    vec3 x2 = x * x;
    vec3 x4 = x2 * x2;
    return + 15.5     * x4 * x2
           - 40.14    * x4 * x
           + 31.96    * x4
           - 6.868    * x2 * x
           + 0.4298   * x2
           + 0.1191   * x
           - 0.00232;
}

vec3 agx(vec3 val)
{
    const mat3 agx_mat = mat3(
        0.842479062253094, 0.0423282422610123, 0.0423756549057051,
        0.0783847559183253, 0.878468636469772, 0.0788490074572186,
        0.0791421364302589, 0.0791661274615315, 0.879129973650547);
    const float min_ev = -12.47393;
    const float max_ev = 4.026069;

    val = agx_mat * max(val, vec3(0.0));
    val = clamp(log2(max(val, vec3(1.0e-10))), vec3(min_ev), vec3(max_ev));
    val = (val - min_ev) / (max_ev - min_ev);
    return agxDefaultContrastApprox(val);
}

vec3 agxEotf(vec3 val)
{
    const mat3 agx_mat_inv = mat3(
        1.19687900512017, -0.0528968517574562, -0.0529716355144438,
        -0.0980208811401368, 1.15190312990417, -0.0980434501171241,
        -0.0990297440797205, -0.0989611768448433, 1.15107367264116);
    val = agx_mat_inv * val;
    return pow(max(val, vec3(0.0)), vec3(2.2));
}

// ---------------------------------------------------------------------------
// mode 2: Khronos PBR Neutral（model-viewer/three.js 移植，MIT）。输入输出线性。
// ---------------------------------------------------------------------------
vec3 khronosPbrNeutral(vec3 color)
{
    const float startCompression = 0.8 - 0.04;
    const float desaturation = 0.15;

    float x = min(color.r, min(color.g, color.b));
    float offset = x < 0.08 ? x - 6.25 * x * x : 0.04;
    color -= offset;

    float peak = max(color.r, max(color.g, color.b));
    if(peak < startCompression)
    {
        return color;
    }

    const float d = 1.0 - startCompression;
    const float newPeak = 1.0 - d * d / (peak + d - startCompression);
    color *= newPeak / peak;

    const float g = 1.0 - 1.0 / (desaturation * (peak - newPeak) + 1.0);
    return mix(color, vec3(newPeak), g);
}

// ---------------------------------------------------------------------------
// mode 3: ACES（Stephen Hill 的 RRT+ODT 拟合；three.js 移植，MIT）。
// ---------------------------------------------------------------------------
vec3 rrtAndOdtFit(vec3 v)
{
    vec3 a = v * (v + 0.0245786) - 0.000090537;
    vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
    return a / b;
}

vec3 acesFilmic(vec3 color)
{
    const mat3 acesInputMat = mat3(
        vec3(0.59719, 0.07600, 0.02840),
        vec3(0.35458, 0.90834, 0.13383),
        vec3(0.04823, 0.01566, 0.83777));
    const mat3 acesOutputMat = mat3(
        vec3( 1.60475, -0.10208, -0.00327),
        vec3(-0.53108,  1.10813, -0.07276),
        vec3(-0.07367, -0.00605,  1.07602));

    color *= 1.0 / 0.6;
    color = acesInputMat * color;
    color = rrtAndOdtFit(color);
    color = acesOutputMat * color;
    return clamp(color, vec3(0.0), vec3(1.0));
}
// ---------------------------------------------------------------------------
// mode 4: Uncharted 2 / Hable filmic。输入输出线性。
// ---------------------------------------------------------------------------
vec3 uncharted2Fit(vec3 v)
{
    const float A = 0.15;
    const float B = 0.50;
    const float C = 0.10;
    const float D = 0.20;
    const float E = 0.02;
    const float F = 0.30;
    return ((v * (A * v + C * B) + D * E) / (v * (A * v + B) + D * F)) - E / F;
}

vec3 uncharted2(vec3 x)
{
    const float exposureBias = 2.0;
    vec3 current = uncharted2Fit(x * exposureBias);
    vec3 whiteScale = vec3(1.0) / uncharted2Fit(vec3(11.2));
    return current * whiteScale;
}

// ---------------------------------------------------------------------------
// mode 5: Reinhard-Jodie。输入输出线性。
// ---------------------------------------------------------------------------
vec3 reinhardJodie(vec3 v)
{
    const float luma = dot(v, vec3(0.2126, 0.7152, 0.0722));
    const vec3 tc = v / (1.0 + v);
    return mix(v / (1.0 + luma), tc, tc);
}



// 2026-11-25：ACES2 改走 65x65x65 RGBA16F 3D Shaper LUT（启动首帧由 aces2_bake_lut.comp 一次性烘焙）。
// 输入 shaper：u = log2(1 + clamp(x, 0, 1024) * 256) / log2(1 + 1024 * 256)
// 输出编码：LUT 存 sqrt(displayLinear)，采样后 s * s 还原线性显示值（8-bit sRGB 平均误差 0.065/255）。
vec3 aces2DisplayLinear(vec3 linearSrgb)
{
    const float LUT_SIZE = 65.0;
    const float SHAPER_K = 256.0;
    const float SHAPER_MAX = 1024.0;
    const float INV_LOG2_DENOM = 1.0 / 18.000005503399316;
    vec3 c = clamp(linearSrgb, vec3(0.0), vec3(SHAPER_MAX));
    vec3 u = log2(vec3(1.0) + c * SHAPER_K) * INV_LOG2_DENOM;
    vec3 uvw = (u * (LUT_SIZE - 1.0) + vec3(0.5)) * (1.0 / LUT_SIZE);
    vec3 s = max(textureLod(aces2Lut3D, uvw, 0.0).rgb, vec3(0.0));
    return s * s;
}


const vec3 GRADE_LUMA = vec3(0.2126, 0.7152, 0.0722);

// 色调轮：hue 度 → 纯色（HSV 的 S=1 V=1，六段式）。
vec3 gradeHueColor(float deg)
{
    return clamp(abs(mod(deg / 60.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0, 0.0, 1.0);
}

// 绕灰轴 (1,1,1)/√3 旋转色相（Rodrigues）。灰轴上的颜色（R=G=B）旋转后不变，
// 所以中性灰不会被染色 —— 这正是想要的：只把"有彩"的部分往冷/暖推。
vec3 gradeHueRotate(vec3 c, float deg)
{
    const vec3 axis = vec3(0.57735026919);
    float a = radians(deg);
    float cs = cos(a);
    float sn = sin(a);
    return c * cs + cross(axis, c) * sn + axis * dot(axis, c) * (1.0 - cs);
}

// 分离色调：把"当前色相相对灰轴的色度偏移"按亮度掩码加到画面上。
// 用加色度（而不是乘法）是为了保持亮度不变：strength 只推色相，不动明暗。
vec3 gradeSplitTone(vec3 c, float hue, float strength, float mask)
{
    vec3 tint = gradeHueColor(hue);
    vec3 chroma = tint - vec3(dot(tint, GRADE_LUMA));
    return c + chroma * (strength * mask * 0.35);
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(rrOutputImage);

    if(p.x >= size.x || p.y >= size.y)
    {
        return;
    }

    vec4 color = imageLoad(rrOutputImage, p);

    color.rgb = mix(color.rgb, vec3(0.0), isnan(color.rgb));
    color.rgb = mix(color.rgb, vec3(0.0), isinf(color.rgb));
    color.rgb = max(color.rgb, vec3(0.0));

#if RR_STABLE_GLASS_RADIANCE
#ifndef POST_SKIP_STABLE
#define POST_SKIP_STABLE 0
#endif
#if !POST_SKIP_STABLE
    vec3 stableRadiance =
        (textureSize(rrStableRadianceImage, 0) == size)
            ? texelFetch(rrStableRadianceImage, p, 0).rgb
            : texture(
                  rrStableRadianceImage,
                  (vec2(p) + vec2(0.5)) / vec2(size)
              ).rgb;

    color.rgb +=
        max(
            mix(
                stableRadiance,
                vec3(0.0),
                isnan(stableRadiance)
            ),
            vec3(0.0)
        );
#endif
#endif

    vec3 exposed =
        max(
            color.rgb * exp2(currentEV * postPush.exposureStrength),
            vec3(0.0)
        );

    exposed *= vec3(postPush.gainR, postPush.gainG, postPush.gainB);

    exposed *= exp2(postPush.manualEV);

    vec3 displayLinear;
    if(postPush.tonemapMode == 1)
    {
        displayLinear = agxEotf(agx(exposed));
    }
    else if(postPush.tonemapMode == 2)
    {
        displayLinear = khronosPbrNeutral(exposed);
    }
    else if(postPush.tonemapMode == 3)
    {
        displayLinear = acesFilmic(exposed);
    }
    else if(postPush.tonemapMode == 4)
    {
        displayLinear = uncharted2(exposed);
    }
    else if(postPush.tonemapMode == 5)
    {
        displayLinear = reinhardJodie(exposed);
    }
    else if(postPush.tonemapMode == 6)
    {
        displayLinear = aces2DisplayLinear(exposed);
    }
    else
    {
        displayLinear = uchimura(exposed);
    }

    vec3 displayColor = pow(max(displayLinear, vec3(0.0)), vec3(1.0 / postPush.gamma));
    const float luma = dot(displayColor, vec3(0.2126, 0.7152, 0.0722));
    displayColor = mix(vec3(luma), displayColor, postPush.saturation);

    bool cgActive =
        postPush.blackPoint != 0.0 ||
        postPush.whitePoint != 1.0 ||
        postPush.gradeContrast != 1.0 ||
        postPush.liftR != 0.0 || postPush.liftG != 0.0 || postPush.liftB != 0.0 ||
        postPush.gradeGammaR != 1.0 || postPush.gradeGammaG != 1.0 ||
        postPush.gradeGammaB != 1.0 ||
        postPush.gradeGainR != 1.0 || postPush.gradeGainG != 1.0 ||
        postPush.gradeGainB != 1.0 ||
        postPush.shadowStrength != 0.0 ||
        postPush.highlightStrength != 0.0 ||
        postPush.vibrance != 0.0 ||
        postPush.fade != 0.0 ||
        postPush.vignette != 0.0 ||
        postPush.hueRotate != 0.0 ||
        postPush.tintGreen != 0.0;

    if(cgActive)
    {
        const float cgSpan = max(postPush.whitePoint - postPush.blackPoint, 1.0e-3);
        displayColor =
            max((displayColor - vec3(postPush.blackPoint)) / cgSpan, vec3(0.0));

        displayColor =
            max((displayColor - vec3(postPush.gradePivot)) * postPush.gradeContrast
                + vec3(postPush.gradePivot), vec3(0.0));

        const vec3 cdGain =
            vec3(postPush.gradeGainR, postPush.gradeGainG, postPush.gradeGainB);
        const vec3 cdLift =
            vec3(postPush.liftR, postPush.liftG, postPush.liftB);
        const vec3 cdGamma =
            vec3(postPush.gradeGammaR, postPush.gradeGammaG, postPush.gradeGammaB);

        if(cdGain != vec3(1.0) || cdLift != vec3(0.0) || cdGamma != vec3(1.0))
        {
            displayColor =
                pow(max(displayColor * cdGain + cdLift, vec3(0.0)), 1.0 / cdGamma);
        }

        if(postPush.hueRotate != 0.0)
        {
            displayColor = gradeHueRotate(displayColor, postPush.hueRotate);
        }

        if(postPush.shadowStrength != 0.0 || postPush.highlightStrength != 0.0)
        {
            const float tl = dot(displayColor, GRADE_LUMA);
            const float shadowMask = 1.0 - smoothstep(0.0, 0.55, tl);
            const float highMask = smoothstep(0.45, 1.0, tl);

            if(postPush.shadowStrength != 0.0)
            {
                displayColor = gradeSplitTone(
                    displayColor, postPush.shadowHue, postPush.shadowStrength, shadowMask);
            }
            if(postPush.highlightStrength != 0.0)
            {
                displayColor = gradeSplitTone(
                    displayColor, postPush.highlightHue, postPush.highlightStrength, highMask);
            }
        }

        if(postPush.vibrance != 0.0)
        {
            const float vl = dot(displayColor, GRADE_LUMA);
            const float mx = max(displayColor.r, max(displayColor.g, displayColor.b));
            const float mn = min(displayColor.r, min(displayColor.g, displayColor.b));
            const float chroma = max(mx - mn, 0.0);
            const float amount = postPush.vibrance * (1.0 - smoothstep(0.0, 0.7, chroma));
            displayColor =
                mix(vec3(vl), displayColor, clamp(1.0 + amount, 0.0, 2.0));
        }

        if(postPush.fade != 0.0)
        {
            displayColor = displayColor * (1.0 - 0.30 * postPush.fade)
                         + vec3(0.11 * postPush.fade);
        }

        if(postPush.tintGreen != 0.0)
        {
            displayColor *=
                vec3(1.0 - 0.05 * postPush.tintGreen,
                     1.0 + 0.07 * postPush.tintGreen,
                     1.0 - 0.05 * postPush.tintGreen);
        }

        if(postPush.vignette != 0.0)
        {
            const vec2 halfSize = vec2(size) * 0.5;
            const vec2 q = (vec2(p) + vec2(0.5) - halfSize) / max(halfSize.x, 1.0);
            const float radial = length(q) / max(length(vec2(1.0, halfSize.y / max(halfSize.x, 1.0))), 1.0e-3);
            const float falloff =
                smoothstep(postPush.vignetteRadius, 1.0, radial);
            displayColor *= (1.0 - postPush.vignette * falloff);
        }

        displayColor += sdrTriangularDither(uvec2(p));
        displayColor = clamp(displayColor, vec3(0.0), vec3(1.0));
    }

    imageStore(
        rrOutputImage,
        p,
        vec4(displayColor, color.a)
    );
}
