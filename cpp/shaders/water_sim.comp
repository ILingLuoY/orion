    down      = mix(height, down,      maskD);
    up        = mix(height, up,        maskU);
    downLeft  = mix(height, downLeft,  maskDL);
    downRight = mix(height, downRight, maskDR);
    upLeft    = mix(height, upLeft,    maskUL);
    upRight   = mix(height, upRight,   maskUR);

