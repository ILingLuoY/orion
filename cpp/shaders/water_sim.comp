#extension GL_GOOGLE_include_directive : require


layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2DArray waterStateInput;
layout(rg16f, set = 0, binding = 1) uniform writeonly image2DArray waterStateOutput;

layout(set = 0, binding = 2) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;

layout(set = 0, binding = 3) uniform WaterSimEntities
{
    ivec4 entityCounts;
    vec4 entityImpulses[8];
    vec4 entityBoats[8];
    vec4 entityBoatParams[8];
} simEntities;

// 2026-11-21 水体掩码（48×48 R8，块分辨率，1 = 水 / 0 = 陆地）。
// 宿主按块扫描玩家周围 48×48 窗口上传；origin 随上传一起走 push。
layout(set = 0, binding = 4) uniform sampler2D waterSimMask;

layout(push_constant) uniform WaterSimulationPush
{
    uvec4 layersAndFlags;
    vec4 updateAndImpulse;
    ivec4 scrollAndPadding;
    vec4 waveParams;
    float waveSpeed;
    float waveShapeScale;
    float waveShapeAngle;
    float waveShapeCrest;
    float waveShapeWarp;
    // 2026-11-21 交互波升级：雨涟漪 / 水体掩码 / 尾迹 stamp（与 C++
    // WaterSimPushConstants 逐字节对齐，新增 7 个 4 字节标量，总 112B）。
    float rainStrength;
    uint simStepIndex;
    float maskOriginX;
    float maskOriginZ;
    uint maskEnabled;
    // 2026-11-21 雨滴涟漪强度倍率（UI「雨滴涟漪」，0 = 关，出厂 1.5）。
    float rainRippleScale;
    // 2026-11-21 顾问轮1：1/掩码边长（单点真相，替代着色端字面量 48.0）。
    float invMaskExtent;
} pushData;

// 9 点各向同性拉普拉斯开关（1 = 新档，0 = 逐位回 5 点旧档）。
// 5 点模板的波前呈菱形、轴向传播偏快；9 点（轴向:对角 = 1:0.5，归一化到
// 与 5 点同量纲）4 阶各向同性。最大特征值 |λ|max = 16/3 < 8 ⇒ 现有
// laplacianCoeff ≤ 0.45 的稳定域不变。
#ifndef WATER_SIM_ISOTROPIC_LAPLACIAN
#define WATER_SIM_ISOTROPIC_LAPLACIAN 1
#endif

// 雨点涟漪（sim 大滴点缀）：每子步确定性撒点预算（rain²·BUDGET，≤ 16）。
// 2026-11-21 顾问轮1 路线定档：细密雨环由消费端解析层
//（rchit_helpers_water.glsl / rt_test_translucent.rchit 的
// rainImpactRippleGradient，增益已 3×）承担——sim 网格奈奎斯特 ~0.19m，
// 结构上长不出 <0.35m 的锐环。本 sim 保留极少量**大滴**当重雨点缀：
// 墨西哥帽零均值 stamp（水面不可压缩 ⇒ 坑缘挤起一圈隆起，消低频塌陷）。
#ifndef WATER_SIM_RAIN_DROP_BUDGET
#define WATER_SIM_RAIN_DROP_BUDGET 6.0
#endif

uint waterSimPcgHash(uint v)
{
    v = v * 747796405u + 2891336453u;
    uint w = ((v >> ((v >> 28u) + 4u)) ^ v) * 277803737u;
    return (w >> 22u) ^ w;
}

// 零均值墨西哥帽（LoG）：中心 -1 凹陷，r=√2·σ 处 +0.135 隆起环。
// 正负体积相平 ⇒ 不留低频洼地，能量全部进扩张环波段。
float rainMexicanHat(vec2 delta, float radius)
{
    float r = length(delta);
    if(r >= radius) return 0.0;
    float sigma = radius * 0.32;
    float u2 = (r * r) / (2.0 * sigma * sigma);
    float window = 1.0 - smoothstep(radius * 0.75, radius, r);   // 消截断台阶
    return (1.0 - u2) * exp(-u2) * window;
}

// 2026-11-21 顾问轮1（F3）：单点水体掩码（1 = 水）。0.45/0.55 陡肩保留
// LINEAR 对方块直角的微倒角、去掉旧 0.35/0.65 的 3 texel 吸波软肩。
float sampleWaterMask(vec2 worldPos)
{
    if(pushData.maskEnabled == 0u) return 1.0;
    vec2 uv = (worldPos - vec2(pushData.maskOriginX, pushData.maskOriginZ)) *
        pushData.invMaskExtent;
    if(any(lessThanEqual(uv, vec2(0.0))) || any(greaterThanEqual(uv, vec2(1.0))))
        return 1.0;
    return smoothstep(0.45, 0.55, texture(waterSimMask, uv).r);
}

const ivec2 RESOLUTION = ivec2(512);

vec3 readState(ivec2 texel)
{
    ivec2 clampedTexel = clamp(texel, ivec2(0), RESOLUTION - ivec2(1));
    return texelFetch(
        waterStateInput,
        ivec3(clampedTexel, int(pushData.layersAndFlags.x)),
        0
    ).rgb;
}

// 高度 pass 读的是动量 pass 的输出层（layersAndFlags.y），坐标已对齐、无滚动。
vec3 readHeightPassState(ivec2 texel)
{
    ivec2 clampedTexel = clamp(texel, ivec2(0), RESOLUTION - ivec2(1));
    return texelFetch(
        waterStateInput,
        ivec3(clampedTexel, int(pushData.layersAndFlags.y)),
        0
    ).rgb;
}

float concentricRipples(vec2 delta, float radius, float rings)
{
    float dist = length(delta);
    if(dist >= radius)
    {
        return 0.0;
    }
    float envelope = 0.5 + 0.5 * cos((dist / radius) * 3.14159265359);
    float wave = cos((dist / radius) * rings * 6.28318530718);
    return wave * envelope;
}

// 参考 HPWaterWaveEquation 的高斯波源：sigma = radius*0.4、中心连续、边界归零。
// 参考另有 min(ripple, 0.05) 的安全帽 —— 那是它自己归一化下的值；本引擎的场是
// 世界格量纲（height 另有 ±4 安全阀，见 main 末尾），所以这里保留形状与
// "边界平滑归零"的语义，幅值仍按本引擎标定（调用处与旧路径同系数）。
float gaussianWaveSource(vec2 delta, float radius)
{
    float r = length(delta);
    if(r >= radius)
    {
        return 0.0;
    }
    float sigma = radius * 0.4;
    return exp(-r * r / max(2.0 * sigma * sigma, 1.0e-6));
}

