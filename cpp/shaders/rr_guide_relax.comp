
#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba16f) uniform image2D normalRoughnessImage;
layout(binding = 1, r32f) uniform image2D depthImage;
layout(binding = 2, rgba16f) uniform image2D diffuseAlbedoImage;
layout(binding = 3, r32f) uniform image2D specularHitDistanceImage;
layout(binding = 4, rgba16f) uniform image2D specularAlbedoImage;
layout(binding = 5) uniform sampler2D cloudResolvedImage;
layout(binding = 6) uniform sampler2D cloudDepthImage;
layout(binding = 7) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;
layout(binding = 8, rg16f) readonly uniform image2D primaryMotionImage;
layout(binding = 9, rg16f) writeonly uniform image2D specularMotionImage;
layout(binding = 10) uniform sampler3D fogIntegrated;
layout(binding = 11, rgba16f) readonly uniform image3D fogDensityMeta;

layout(push_constant) uniform RRGuideRelaxPush
{
    uvec2 extent;
    float relaxScale;
    float minRoughness;
    float normalFalloff;
    float farCloudDistance;
    float fogMaxDistance;
    float fogLayers;
} pc;

#include "fog_froxel_common.glsl"

#ifndef RR_GUIDE_PURIFY_V1
#define RR_GUIDE_PURIFY_V1 1
#endif

#ifndef RR_FOG_GUIDE_MODULATE
#define RR_FOG_GUIDE_MODULATE 1
#endif

const float NEIGHBOR_EPS = 0.00002;
const float NEIGHBOR_SCALE = 25.0;

shared vec4 tile[18 * 18];
shared float tileDelta[18 * 18];

ivec2 tileLocal(ivec2 pixel, ivec2 groupBase)
{
    return pixel - groupBase + ivec2(1, 1);
}

void accumRelaxNeighbor(
    ivec2 o,
    vec3 n0,
    inout float deltaNeighbor,
    inout float normalSpread)
{
    int idx = o.x + 18 * o.y;
    vec4 n = tile[idx];
    deltaNeighbor = max(deltaNeighbor, tileDelta[idx]);
    float v = 0.02;
#if RR_GUIDE_PURIFY_V1
    float nLen2 = dot(n.xyz, n.xyz);
    if(n.w > 0.0 && nLen2 > 1.0e-8)
    {
        v = clamp(1.0 - dot(n0, n.xyz * inversesqrt(nLen2)), 0.0, 1.0);
    }
#else
    if(n.w > 0.0)
    {
        v = clamp(1.0 - dot(n0, normalize(n.xyz)), 0.0, 1.0);
    }
#endif
    normalSpread += v;
}

void main()
{
    ivec2 extent = ivec2(pc.extent);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 groupBase = ivec2(gl_WorkGroupID.xy) * ivec2(16, 16);

    for(uint i = gl_LocalInvocationIndex; i < 18u * 18u;
        i += 16u * 16u)
    {
        ivec2 local = ivec2(int(i % 18u), int(i / 18u));
        ivec2 src = clamp(groupBase + local - ivec2(1, 1), ivec2(0), extent - ivec2(1));

        vec4 nr = imageLoad(normalRoughnessImage, src);
        float deltaFlag = imageLoad(diffuseAlbedoImage, src).a;
        float depth = imageLoad(depthImage, src).r;

        float valid = depth > 1.0e-6 ? 1.0 : 0.0;
        tile[i] = vec4(nr.xyz, depth > 1.0e-6 ? nr.w : 0.0);
        tileDelta[i] = valid * deltaFlag;
    }

    barrier();
    memoryBarrierShared();

    if(any(greaterThanEqual(pixel, extent)))
    {
        return;
    }

    ivec2 local = tileLocal(pixel, groupBase);
    vec4 center = tile[local.x + 18 * local.y];
#if RR_GUIDE_PURIFY_V1
    float centerDepth = imageLoad(depthImage, pixel).r;
#endif

    float deltaHere = tileDelta[local.x + 18 * local.y];
    float deltaNeighbor = 0.0;
    float normalSpread = 0.0;

#if RR_GUIDE_PURIFY_V1
    float centerLen2 = dot(center.xyz, center.xyz);
    vec3 n0 = centerLen2 > 1.0e-8 ? center.xyz * inversesqrt(centerLen2) : vec3(0.0, 1.0, 0.0);
#else
    vec3 n0 = normalize(center.xyz);
#endif
    accumRelaxNeighbor(local + ivec2(-1, 0), n0, deltaNeighbor, normalSpread);
    accumRelaxNeighbor(local + ivec2( 1, 0), n0, deltaNeighbor, normalSpread);
    accumRelaxNeighbor(local + ivec2( 0,-1), n0, deltaNeighbor, normalSpread);
    accumRelaxNeighbor(local + ivec2( 0, 1), n0, deltaNeighbor, normalSpread);

    float gate = max(deltaHere, deltaNeighbor);
    float relax = clamp((normalSpread - NEIGHBOR_EPS) * NEIGHBOR_SCALE, 0.0, 1.0);
    relax = clamp(relax * pc.relaxScale * gate, 0.0, 1.0);

    float roughness = clamp(center.w, 0.0, 1.0);
#if RR_GUIDE_PURIFY_V1
    float minR = gate > 0.0 ? max(pc.minRoughness, roughness) : roughness;
    float relaxed = clamp(
        mix(roughness, 1.0, relax),
        minR,
        1.0
    );
#else
    float relaxed = clamp(
        mix(roughness, 1.0, relax),
        max(pc.minRoughness, roughness),
        1.0
    );
#endif

    // Specular motion vectors for DLSS-RR (virtual reflected point from primaryHit + specHitDist)
    vec2 primaryMV = imageLoad(primaryMotionImage, pixel).rg;
    vec2 specMV = primaryMV;
    float specHitDist = imageLoad(specularHitDistanceImage, pixel).r;
    bool needRayReconstruct =
        (pc.farCloudDistance > 0.0) ||
        (pc.fogMaxDistance > 0.0) ||
        (centerDepth > 1.0e-6 && specHitDist > 0.05 && specHitDist < 50000.0 && roughness < 0.35);

    vec3 worldDirection = vec3(0.0, 0.0, -1.0);
    float nearPlane = 0.05;
    float cosine = 1.0;
    float sceneDist = 1.0e30;
    if(needRayReconstruct)
    {
        vec2 ndc = (vec2(pixel) + 0.5) / vec2(extent) * 2.0 - 1.0;
        ndc.y = -ndc.y;
        vec4 viewHomogeneous = cam.projInverse * vec4(ndc, 1.0, 1.0);
        float viewW = abs(viewHomogeneous.w) > 1.0e-6
            ? viewHomogeneous.w
            : 1.0;
        vec3 viewTarget = normalize(viewHomogeneous.xyz / viewW);
        worldDirection = normalize((cam.viewInverse * vec4(viewTarget, 0.0)).xyz);
        nearPlane = -viewHomogeneous.z / viewW;
        cosine = max(-viewTarget.z, 1.0e-3);
        sceneDist = centerDepth > 1.0e-6
            ? nearPlane / max(centerDepth * cosine, 1.0e-5)
            : 1.0e30;

        if(centerDepth > 1.0e-6 && specHitDist > 0.05 && specHitDist < 50000.0 && roughness < 0.35)
        {
            vec3 camOrigin = (cam.viewInverse * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
            vec3 virtualPos = camOrigin + worldDirection * (sceneDist + specHitDist);
            vec4 prevClip = cam.prevViewProj * vec4(virtualPos, 1.0);
            vec4 curClip = cam.viewProj * vec4(virtualPos, 1.0);
            if(abs(prevClip.w) > 1.0e-6 && abs(curClip.w) > 1.0e-6)
            {
                vec2 virtualMV = (prevClip.xy / prevClip.w - curClip.xy / curClip.w) * vec2(0.5, -0.5);
                float specWeight = 1.0 - smoothstep(0.20, 0.35, roughness);
                specMV = mix(primaryMV, virtualMV, specWeight);
            }
        }
    }
    bool isCloudOverride = false;
    float effectiveDepth = centerDepth;
    float effectiveDist = sceneDist;
    vec4 outNormalRough = vec4(center.xyz, (pc.relaxScale > 0.0) ? relaxed : roughness);
    bool writeNormalRough = (pc.relaxScale > 0.0 && centerDepth > 1.0e-6);
    vec4 outDiffAlbedo = vec4(0.0);
    vec4 outSpecAlbedo = vec4(0.0);
    bool writeAlbedo = false;
    vec2 outSpecMV = specMV;

    if(pc.farCloudDistance > 0.0)
    {
        vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
        vec4 cloudLayer = textureLod(cloudResolvedImage, uv, 0.0);
        float cloudDistance = textureLod(cloudDepthImage, uv, 0.0).r;
        float transmittance = clamp(cloudLayer.a, 0.0, 1.0);

        if(transmittance < 0.999 &&
           cloudDistance >= pc.farCloudDistance &&
           cloudDistance < 9.0e5)
        {
            float cloudDepth = clamp(
                nearPlane / max(cloudDistance * cosine, 1.0e-3), 0.0, 1.0);

#if RR_GUIDE_PURIFY_V1
            if(centerDepth <= 1.0e-6 || sceneDist >= cloudDistance)
#endif
            {
                isCloudOverride = true;
                effectiveDepth = cloudDepth;
                effectiveDist = cloudDistance;
                float deltaFlag = imageLoad(diffuseAlbedoImage, pixel).a;
                outDiffAlbedo = vec4(max(cloudLayer.rgb, vec3(0.0)), deltaFlag);
                outSpecAlbedo = vec4(0.0, 0.0, 0.0, 1.0);
                outNormalRough = vec4(-worldDirection, 1.0);
                writeAlbedo = true;
                writeNormalRough = true;
                outSpecMV = primaryMV;
                imageStore(specularHitDistanceImage, pixel,
                    vec4(cloudDistance, 0.0, 0.0, 0.0));
                imageStore(depthImage, pixel, vec4(cloudDepth, 0.0, 0.0, 0.0));
            }
        }
    }

#if RR_FOG_GUIDE_MODULATE
    if(pc.fogMaxDistance > 0.0 &&
       cam.cloudParams7.x >= 0.5 &&
       cam.waterSimState.w == 0u &&
       effectiveDepth > 1.0e-6)
    {
        const float maxDistance = max(pc.fogMaxDistance, 16.0);
        const int layers = max(int(pc.fogLayers + 0.5), 2);
        const float startDistance = clamp(cam.cloudParams9.x, 0.0, maxDistance);
        const vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
        const float evalDistRaw = isCloudOverride
            ? effectiveDist
            : fogSceneDistanceForDepth(uv, effectiveDepth, cam.projInverse);
        const float evalDistance = min(evalDistRaw, maxDistance);

        if(evalDistance > startDistance + 1.0e-3)
        {
            const float lookupDistance = max(startDistance, evalDistance - 0.18);
            const float wMin = 0.5 / float(layers);
            const float wMax = (float(layers) - 0.5) / float(layers);
            const float w = clamp(
                fogDistanceToIntegratedW(lookupDistance, maxDistance, layers),
                wMin,
                wMax);

            const ivec3 fogSize = textureSize(fogIntegrated, 0);
            const int metaZ = clamp(layers - 1, 0, max(fogSize.z - 1, 0));
            const vec2 fCoord = uv * vec2(fogSize.xy) - 0.5;
            const ivec2 baseXy = ivec2(floor(fCoord));
            const vec2 fracXy = clamp(fCoord - vec2(baseXy), 0.0, 1.0);
            const vec2 invFogXy = 1.0 / vec2(max(fogSize.xy, ivec2(1)));

            vec4 fogSum = vec4(0.0);
            float wSum = 0.0;
            float bestFallbackScore = -1.0e20;
            vec4 bestFog = vec4(0.0, 0.0, 0.0, 1.0);

            for(int oy = 0; oy <= 1; ++oy)
            {
                for(int ox = 0; ox <= 1; ++ox)
                {
                    const ivec2 cxy = clamp(
                        baseXy + ivec2(ox, oy),
                        ivec2(0),
                        max(fogSize.xy - ivec2(1), ivec2(0)));
                    const float bW =
                        (ox == 0 ? 1.0 - fracXy.x : fracXy.x) *
                        (oy == 0 ? 1.0 - fracXy.y : fracXy.y);
                    const vec4 meta = imageLoad(fogDensityMeta, ivec3(cxy, metaZ));
                    const float tileMinDist = (meta.a > 0.5) ? meta.r : 0.0;
                    const float tileMaxDist = (meta.a > 0.5) ? meta.g : maxDistance;
                    const float depthValid = fogScreenTapDepthWeight(
                        lookupDistance, true, tileMinDist, tileMaxDist);
                    const float farValid = smoothstep(
                        lookupDistance * 0.72,
                        lookupDistance * 0.96,
                        tileMaxDist);
                    const float fallbackScore =
                        farValid * 1000.0 - abs(tileMinDist - lookupDistance) + bW * 0.1;
                    const vec2 tapUv = (vec2(cxy) + 0.5) * invFogXy;
                    const vec4 tapFog = textureLod(fogIntegrated, vec3(tapUv, w), 0.0);
                    fogSum += tapFog * (bW * depthValid);
                    wSum += bW * depthValid;
                    if(fallbackScore > bestFallbackScore)
                    {
                        bestFallbackScore = fallbackScore;
                        bestFog = tapFog;
                    }
                }
            }
            const vec4 fog = (wSum > 1.0e-4) ? (fogSum / wSum) : bestFog;

            if(all(equal(fog, fog)))
            {
                const float fogT = clamp(fog.a, 0.0, 1.0);
                const float fogOpacity = 1.0 - fogT;
                if(fogOpacity > 1.0e-3)
                {
                    if(!writeAlbedo)
                    {
                        outDiffAlbedo = imageLoad(diffuseAlbedoImage, pixel);
                        outSpecAlbedo = imageLoad(specularAlbedoImage, pixel);
                    }
                    const vec3 fogAlbedo = fogEffectiveGuideAlbedo(cam.fogOpticsParams);
                    outDiffAlbedo.rgb = mix(fogAlbedo, max(outDiffAlbedo.rgb, vec3(0.0)), fogT);
                    outSpecAlbedo.rgb = max(outSpecAlbedo.rgb, vec3(0.0)) * fogT;

                    const float baseNLen2 = dot(outNormalRough.xyz, outNormalRough.xyz);
                    const vec3 baseN = baseNLen2 > 1.0e-8
                        ? outNormalRough.xyz * inversesqrt(baseNLen2)
                        : -worldDirection;
                    const float fogNormalW = smoothstep(0.18, 0.88, fogOpacity);
                    const vec3 blendedN = mix(baseN, -worldDirection, fogNormalW);
                    const float bnLen2 = dot(blendedN, blendedN);
                    outNormalRough.xyz = (bnLen2 > 1.0e-8)
                        ? blendedN * inversesqrt(bnLen2)
                        : -worldDirection;
                    outNormalRough.w = clamp(
                        mix(outNormalRough.w, 1.0, fogOpacity),
                        outNormalRough.w,
                        1.0);

                    outSpecMV = mix(primaryMV, outSpecMV, fogT);
                    writeAlbedo = true;
                    writeNormalRough = true;
                }
            }
        }
    }
#endif

    imageStore(specularMotionImage, pixel, vec4(outSpecMV, 0.0, 0.0));
    if(writeAlbedo)
    {
        imageStore(diffuseAlbedoImage, pixel, outDiffAlbedo);
        imageStore(specularAlbedoImage, pixel, outSpecAlbedo);
    }
    if(writeNormalRough)
    {
        imageStore(normalRoughnessImage, pixel, outNormalRough);
    }
}
