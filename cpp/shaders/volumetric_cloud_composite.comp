#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D cloudInput;
layout(rgba16f, set = 0, binding = 1) uniform image2D sceneOutputNear;
layout(rgba16f, set = 0, binding = 6) uniform image2D sceneOutputFar;
layout(set = 0, binding = 2) uniform sampler2D sceneDepth;
layout(set = 0, binding = 5) uniform sampler2D cloudDepthImage;

layout(push_constant) uniform CloudCompositePush
{
    float splitDistance;
    float mode;
    // 2026-11-15：云 shoulder 的白点改为**与下游曝光同口径**。
    //
    // 旧实现：white = exp2(-currentEV) —— 等价于假设"曝光强度 = 1.0"。
    // 但下游真正乘以的是 exp2(currentEV * exposureStrength)：
    //   SDR: rr_sdr_post.comp 用 postPush.exposureStrength（默认 0.5）
    //   HDR: rr_hdr_encode.comp 用常量 0.6
    // ⇒ 白点与曝光差 exp2(±0.5 * EV)：EV 越负（画面越亮 / 抬头看天），
    // 白点被放得越大，云被压到远高于实际显示白点的位置，整片云发白、
    // 亮面/暗面层次被抹平 —— 这就是"云的受光很怪"。
    //
    // 现在：white = exp2(-currentEV * exposureStrength) * whiteScale，
    // 白点乘上下游曝光后正好落在显示白点（HDR 是 4 倍参考白）。
    float whiteScale;
    float exposureStrength;
} pc;
layout(set = 0, binding = 3) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;

layout(set = 0, binding = 4) readonly buffer AeState
{
    float currentEV;
    float targetEV;
    float avgLogLuma;
    uint sampleCount;
    float cloudWhite;
};

const float CLOUD_SHOULDER_KNEE = 0.75;

vec3 cloudShoulder(vec3 radiance, float displayWhite, float opacity)
{
    float safeOpacity = clamp(opacity, 0.0, 1.0);
    if(safeOpacity <= 1.0e-5)
    {
        return vec3(0.0);
    }
    vec3 unpremul = radiance / safeOpacity;
    float lum = dot(unpremul, vec3(0.2126, 0.7152, 0.0722));
    if(lum <= 1.0e-5)
    {
        return radiance;
    }
    float knee = displayWhite * CLOUD_SHOULDER_KNEE;
    float span = max(displayWhite - knee, 1.0e-4);
    float over = max(lum - knee, 0.0);
    float lumOut = min(lum, knee) + span * over / (over + span);
    vec3 scaled = unpremul * (lumOut / lum);
    // Preserve warm sunset orange/coral/pink hues; gently roll off only extreme solar glints.
    float highlightDesat = smoothstep(displayWhite * 1.4, displayWhite * 4.5, lum);
    scaled = mix(scaled, vec3(lumOut), highlightDesat * 0.35);
    return max(scaled, vec3(0.0)) * safeOpacity;
}

float farBandSceneDistance(vec2 ndc, float depthValue)
{
    if(depthValue <= 1.0e-5)
    {
        return 1.0e30;
    }

    const vec4 p = cam.projInverse * vec4(ndc, depthValue, 1.0);

    if(abs(p.w) <= 1.0e-6)
    {
        return 1.0e30;
    }

    return length(p.xyz / p.w);
}

// Tight exact-pixel + half-render-texel blocker visibility for Far-Band composite.
// Eliminates the 10-15px raw-sky halo cutout around foreground trees/terrain while
// keeping solid foreground surfaces 100% free of far-cloud bleed.
float farBandVisibility(vec2 uv, float splitLo, float splitHi)
{
    ivec2 depthSize = textureSize(sceneDepth, 0);
    if(depthSize.x <= 0 || depthSize.y <= 0)
    {
        return 1.0;
    }

    vec2 exactNdc = uv * 2.0 - 1.0;
    exactNdc.y = -exactNdc.y;

    float centerRaw = textureLod(sceneDepth, uv, 0.0).r;
    // Also sample center render pixel directly with texelFetch to catch 1-pixel opaque geometry
    ivec2 centerPx = clamp(ivec2(uv * vec2(depthSize)), ivec2(0), depthSize - ivec2(1));
    float fetchCenterRaw = texelFetch(sceneDepth, centerPx, 0).r;
    float centerMaxRaw = max(centerRaw, fetchCenterRaw);
    float centerDist = farBandSceneDistance(exactNdc, centerMaxRaw);
    if(centerDist < splitLo)
    {
        return 0.0;
    }

    // Tight +-0.5 render-texel check for smooth 1px feather against foreground edges (never +-2 texels!).
    vec2 halfTexel = 0.5 / vec2(depthSize);
    float maxNeighborRaw = max(
        max(textureLod(sceneDepth, uv + vec2( halfTexel.x,  halfTexel.y), 0.0).r,
            textureLod(sceneDepth, uv + vec2(-halfTexel.x,  halfTexel.y), 0.0).r),
        max(textureLod(sceneDepth, uv + vec2( halfTexel.x, -halfTexel.y), 0.0).r,
            textureLod(sceneDepth, uv + vec2(-halfTexel.x, -halfTexel.y), 0.0).r)
    );
    float nearestNeighborDist = farBandSceneDistance(exactNdc, maxNeighborRaw);
    float centerVis = smoothstep(splitLo, splitHi, centerDist);
    float neighborVis = smoothstep(splitLo, splitHi, nearestNeighborDist);
    return centerVis * mix(0.35, 1.0, neighborVis);
}

// 5-tap clamped Catmull-Rom bicubic reconstruction + bounded micro-sharpness.
// Gives razor-sharp cloud silhouettes at 0.50x under DLSS RR Ultra Performance with zero ringing.
vec4 reconstructCloud(vec2 uv, bool oneToOne, bool downsampling, float sharpKnob)
{
    vec4 centerSample = textureLod(cloudInput, uv, 0.0);
    if(oneToOne || downsampling)
    {
        centerSample.rgb = max(centerSample.rgb, vec3(0.0));
        centerSample.a = clamp(centerSample.a, 0.0, 1.0);
        return centerSample;
    }

    vec2 texSize = vec2(textureSize(cloudInput, 0));
    vec2 invTexSize = 1.0 / texSize;

    vec2 samplePos = uv * texSize;
    vec2 texPos1 = floor(samplePos - 0.5) + 0.5;
    vec2 f = samplePos - texPos1;

    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);

    vec2 w12 = w1 + w2;
    vec2 offset12 = w2 / max(w12, vec2(1.0e-4));

    vec2 tc0  = (texPos1 - 1.0) * invTexSize;
    vec2 tc3  = (texPos1 + 2.0) * invTexSize;
    vec2 tc12 = (texPos1 + offset12) * invTexSize;

    vec4 s01 = textureLod(cloudInput, vec2(tc12.x, tc0.y),  0.0);
    vec4 s10 = textureLod(cloudInput, vec2(tc0.x,  tc12.y), 0.0);
    vec4 s11 = textureLod(cloudInput, vec2(tc12.x, tc12.y), 0.0);
    vec4 s12 = textureLod(cloudInput, vec2(tc3.x,  tc12.y), 0.0);
    vec4 s21 = textureLod(cloudInput, vec2(tc12.x, tc3.y),  0.0);

    float k01 = w12.x * w0.y;
    float k10 = w0.x  * w12.y;
    float k11 = w12.x * w12.y;
    float k12 = w3.x  * w12.y;
    float k21 = w12.x * w3.y;
    float kSum = max(k01 + k10 + k11 + k12 + k21, 1.0e-5);
    vec4 cubic = (s01 * k01 + s10 * k10 + s11 * k11 + s12 * k12 + s21 * k21) / kSum;

    // Anti-ringing 2x2 texel clamp around exact footprint.
    ivec2 iMax = ivec2(texSize) - ivec2(1);
    ivec2 p00 = clamp(ivec2(floor(samplePos - 0.5)), ivec2(0), iMax);
    ivec2 p10 = clamp(p00 + ivec2(1, 0), ivec2(0), iMax);
    ivec2 p01 = clamp(p00 + ivec2(0, 1), ivec2(0), iMax);
    ivec2 p11 = clamp(p00 + ivec2(1, 1), ivec2(0), iMax);
    vec4 t00 = texelFetch(cloudInput, p00, 0);
    vec4 t10 = texelFetch(cloudInput, p10, 0);
    vec4 t01 = texelFetch(cloudInput, p01, 0);
    vec4 t11 = texelFetch(cloudInput, p11, 0);
    vec4 nMin = min(min(t00, t10), min(t01, t11));
    vec4 nMax = max(max(t00, t10), max(t01, t11));

    vec4 result = clamp(cubic, nMin, nMax);

    // Centered noise-cored sharpening: sharpens cloud edges without amplifying pixel-grid halftone dots.
    float sharpAmount = clamp(sharpKnob, 0.0, 2.0) * 0.22;
    if(sharpAmount > 0.005)
    {
        vec4 detail = result - centerSample;
        float detailMag = length(detail.rgb) + abs(detail.a);
        float coreGate = smoothstep(0.015, 0.075, detailMag);
        result = clamp(result + detail * (sharpAmount * coreGate), nMin, nMax);
    }

    result.rgb = max(result.rgb, vec3(0.0));
    result.a = clamp(result.a, 0.0, 1.0);
    return result;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    bool farPass = pc.mode >= 0.5;
    ivec2 size = farPass ? imageSize(sceneOutputFar) : imageSize(sceneOutputNear);
    if(any(greaterThanEqual(pixel, size)))
    {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

    float bandWeight = 1.0;

    if(pc.splitDistance > 0.0)
    {
        const float splitLo = pc.splitDistance * 0.80;
        const float splitHi = pc.splitDistance;
        const float cloudDistance = min(
            textureLod(cloudDepthImage, uv, 0.0).r, 1.0e6);
        const float bandFar = smoothstep(splitLo, splitHi, cloudDistance);

        if(farPass)
        {
            if(bandFar < 1.0e-4)
            {
                return;
            }
            bandWeight = bandFar * farBandVisibility(uv, splitLo, splitHi);
        }
        else
        {
            bandWeight = 1.0 - bandFar;
        }

        if(bandWeight < 1.0e-4)
        {
            return;
        }
    }

    vec4 scene = farPass
        ? imageLoad(sceneOutputFar, pixel)
        : imageLoad(sceneOutputNear, pixel);
    ivec2 cloudSize = textureSize(cloudInput, 0);
    float sharpKnob = farPass ? clamp(cam.cloudLightParams2.z, 0.0, 2.0) : 0.35;
    vec4 cloud = reconstructCloud(
        uv, cloudSize == size, cloudSize.x > size.x, sharpKnob);

#ifndef VPT_CLOUD_SHOULDER_AE_COUPLED
#define VPT_CLOUD_SHOULDER_AE_COUPLED 1
#endif

#if VPT_CLOUD_SHOULDER_AE_COUPLED
    float exposureStrength = clamp(pc.exposureStrength, 0.0, 1.0);
    float displayWhite =
        exp2(-currentEV * exposureStrength) * max(pc.whiteScale, 1.0e-3);
#else
    float displayWhite = exp2(-currentEV) * max(pc.whiteScale, 1.0e-3);
#endif

    cloud.rgb = cloudShoulder(cloud.rgb, displayWhite, 1.0 - cloud.a);
    scene.rgb = scene.rgb * (1.0 - bandWeight + bandWeight * cloud.a) +
        bandWeight * cloud.rgb;
    if(farPass)
    {
        imageStore(sceneOutputFar, pixel, scene);
    }
    else
    {
        imageStore(sceneOutputNear, pixel, scene);
    }
}
