#version 460

// 2026-11-15：自动曝光适应 v2。
//
// 旧版：
//   · 只做一次指数逼近，alpha = 1 - exp(-dt*rate)，没有"线性段"；
//     实测（run/rt_debug.log 2026-11-15 14:07）currentEV 在 1 秒内 ±0.4 反复跳。
//   · trim 默认 0.02/0.98 ≈ 不修剪，云/太阳这类极亮像素直接主导均值。
//   · 直方图 log 范围 [-10, 6]，物理天空/云的辐射经常超出上界，全部堆进最后
//     一个 bin（等于"没有被测光"）。
//
// 现在按 UE 的 Eye Adaptation 口径：
//   · 线性段 + 指数段两段适应，在距目标 transitionDistance（默认 1.5 EV）处
//     切换，切换点一阶连续（指数段速率 k = rate / transitionDistance）。
//     UE 的对应 cvar：r.EyeAdaptation.ExponentialTransitionDistance。
//   · 百分位修剪（Low/High Percent，UE 推荐 70~80 / 80~95 ⇒ 这里 trimLow=0.15、
//     trimHigh=0.90），把最暗/最亮的固定比例样本排除在均值之外。
//   · 死区：|target-current| < 1e-3 EV 时直接吸附，避免量化抖动。
//
// cloudWhite 保留发布，但云合成已经不再读它（见 volumetric_cloud_composite.comp）。

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0, set = 0)
buffer AeHistogram
{
    uint bins[256];
};

layout(binding = 1, set = 0)
buffer AeState
{
    float currentEV;
    float targetEV;
    float avgLogLuma;
    uint sampleCount;
    float cloudWhite;
};

layout(binding = 2, set = 0, r32f)
writeonly uniform image2D dlssExposureImage;

layout(push_constant) uniform AeParams
{
    float dtSec;
    float keyEV;
    float minEV;
    float maxEV;
    float adaptUpRate;      // EV / s（变亮方向）
    float adaptDownRate;    // EV / s（变暗方向）
    float trimLow;          // 0..1，排除最暗的该比例样本
    float trimHigh;         // 0..1，排除最亮的该比例样本
    float logMin;           // 必须与 rr_ae_histogram.comp 一致
    float logMax;           // 必须与 rr_ae_histogram.comp 一致
    float displayWhiteScale;
    float transitionDistance;
    int enabled;
    float exposureStrength;
    float manualEV;
} ae;

const uint AE_BIN_COUNT = 256u;

float binCenter(uint i)
{
    return ae.logMin +
        (float(i) + 0.5) * (ae.logMax - ae.logMin) / float(AE_BIN_COUNT);
}

void clearBins()
{
    for(uint i = 0u; i < AE_BIN_COUNT; ++i)
    {
        bins[i] = 0u;
    }
}

// 每次退出都必须发布，否则云端/白点/DLSS-RR 会拿着已经过期的曝光继续工作。
void publishCloudWhite()
{
    cloudWhite = exp2(-currentEV) * ae.displayWhiteScale;

    // 2026-11-26：DLSS-RR 曝光缓冲改回恒定 1.0。
    // kBufferTypeExposure 的语义是"送进 DLSS 的颜色**已经乘过**的预曝光值"，
    // DLSS-RR 会先把它除掉、在辐射域做时域累积、再乘回去。本管线的曝光是在
    // DLSS **之后**的 rr_sdr_post / rr_hdr_encode 才乘的，DLSS 输入是未曝光辐射
    // （Frame.cpp 里 preExposure 也声明为 1.0）。此前这里写的是
    // 2^(currentEV*strength + manualEV)：曝光每变一次，DLSS 的历史帧就被按
    // e_now/e_prev 的比例错误缩放，自动曝光适应期间出现亮度拖尾 / 呼吸。
    // 预曝光若将来前移到 DLSS 输入之前，把 DLSS_EXPOSURE_PREEXPOSED 置 1 即恢复。
#ifndef DLSS_EXPOSURE_PREEXPOSED
#define DLSS_EXPOSURE_PREEXPOSED 0
#endif
#if DLSS_EXPOSURE_PREEXPOSED
    float activeEV = (ae.enabled != 0) ? (currentEV * ae.exposureStrength) : 0.0;
    float dlssExp = clamp(exp2(activeEV + ae.manualEV), 1.0 / 64.0, 64.0);
#else
    float dlssExp = 1.0;
#endif
    imageStore(dlssExposureImage, ivec2(0, 0), vec4(dlssExp, 0.0, 0.0, 0.0));
}

void main()
{
    if(ae.enabled == 0)
    {
        clearBins();

        currentEV = 0.0;
        targetEV = 0.0;
        avgLogLuma = 0.0;
        sampleCount = 0u;

        publishCloudWhite();

        return;
    }

    uint total = 0u;

    for(uint i = 0u; i < AE_BIN_COUNT; ++i)
    {
        total += bins[i];
    }

    if(total == 0u)
    {
        clearBins();

        sampleCount = 0u;
        targetEV = currentEV;
        avgLogLuma = 0.0;

        publishCloudWhite();

        return;
    }

    float lowFrac = clamp(ae.trimLow, 0.0, 0.98);
    float highFrac = clamp(max(ae.trimHigh, lowFrac), 0.0, 1.0);

    uint lowCut = uint(float(total) * lowFrac);
    uint highCut = uint(float(total) * highFrac);

    uint cum = 0u;
    uint used = 0u;
    float weighted = 0.0;

    for(uint i = 0u; i < AE_BIN_COUNT; ++i)
    {
        uint c = bins[i];
        uint prevCum = cum;

        cum += c;

        uint overlapStart = max(prevCum, lowCut);
        uint overlapEnd = min(cum, highCut);
        if(overlapEnd > overlapStart)
        {
            uint take = overlapEnd - overlapStart;
            weighted += binCenter(i) * float(take);
            used += take;
        }

        bins[i] = 0u;
    }

    if(used == 0u)
    {
        sampleCount = 0u;
        targetEV = currentEV;

        publishCloudWhite();

        return;
    }

    float avgLogLum = weighted / float(used);
    if(isnan(avgLogLum) || isinf(avgLogLum))
    {
        avgLogLum = ae.keyEV - currentEV;
    }

    float target = clamp(ae.keyEV - avgLogLum, ae.minEV, ae.maxEV);

    // ---- 线性 + 指数两段适应 ----------------------------------------------
    float delta = target - currentEV;
    float rate = (delta >= 0.0) ? ae.adaptUpRate : ae.adaptDownRate;
    float step = max(rate, 0.0) * max(ae.dtSec, 0.0);
    float transition = max(ae.transitionDistance, 0.05);

    if(abs(delta) <= 0.015)
    {
        // 死区内保持 currentEV，抑制轻微噪点引起的曝光呼吸抖动
    }
    else if(abs(delta) >= transition)
    {
        currentEV += sign(delta) * min(step, abs(delta));
    }
    else
    {
        float k = max(rate, 1.0e-3) / transition;
        float alpha = 1.0 - exp(-k * max(ae.dtSec, 0.0));
        currentEV = mix(currentEV, target, clamp(alpha, 0.0, 1.0));
    }

    currentEV = clamp(currentEV, ae.minEV, ae.maxEV);

    targetEV = target;
    avgLogLuma = avgLogLum;
    sampleCount = used;

    publishCloudWhite();
}
