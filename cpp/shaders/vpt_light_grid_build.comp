#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(binding = 2, set = 0) uniform CameraProperties {
    #include "camera_ubo.glsl"
} cam;

#include "local_light_profile.glsl"

const uint VLI_PAGE_TABLE_CAPACITY = 8192u;
const uint VLI_PAGE_WORDS = 4096u;
const uint VPT_EMITTER_HEADER_WORDS = 4u;
const uint VLI_SOURCE_WORDS = 4096u;
const uint VPT_EMITTER_PAGE_WORDS = VPT_EMITTER_HEADER_WORDS + VLI_SOURCE_WORDS;
const uint VPT_SOURCE_DIRECTORY_MAX_SECTIONS = 125u;
const uint VPT_SOURCE_DIRECTORY_ENTRIES_PER_PAGE = 1u + VPT_SOURCE_DIRECTORY_MAX_SECTIONS;
const float VPT_LOCAL_MAX_DISTANCE = 30.0;
const float VPT_LOCAL_FADE_START_FRACTION = 0.40;
const uint VPT_LIGHT_GRID_CELLS = 32000u;
const uint VPT_LIGHT_GRID_SLOTS = 32u;

layout(std430, binding = 22, set = 0) readonly buffer PageTable
{
    uint words[];
} vliPageTableBuffer;

layout(std430, binding = 23, set = 0) readonly buffer VLIPagesBuffer
{
    uint words[];
} vliPagesBuffer;

layout(std430, binding = 28, set = 0) readonly buffer VPTEmitterIndexPagesBuffer
{
    uint words[];
} vptEmitterIndexPagesBuffer;

struct VPTSourceDirectoryEntry
{
    uint pageIndex;
    uint emitterCountAndOffset;
    uint aliasThresholdQ16;
    uint aliasIndex;
    float selectionProbability;
};

layout(std430, binding = 31, set = 0) readonly buffer VPTSourceDirectoryPagesBuffer
{
    VPTSourceDirectoryEntry entries[];
} vptSourceDirectoryPagesBuffer;

layout(std430, binding = 99, set = 0) writeonly buffer VPTLightGridBuffer
{
    uvec4 header;
    uvec4 cellMeta[32000];
    uint aliasWords[32000 * 32];
    uvec4 slots[32000 * 32];
} vptLightGridBuffer;

layout(push_constant) uniform GridBuildPush
{
    uvec4 gridParams;
};

float vptLocalLightRangeScale()
{
    float user = cam.rainWallParams1.w;
    return (user >= 0.05 && user <= 8.0) ? user : 1.0;
}

float vptLocalLightRange(uint typeCode, float emissionLevel)
{
    float base = localLightProfileBaseRange(typeCode, emissionLevel);
    return clamp(base * vptLocalLightRangeScale(), 1.5, VPT_LOCAL_MAX_DISTANCE);
}

float vptLocalLightRangeFade(float distanceToLight, uint typeCode, float emissionLevel)
{
    float range = vptLocalLightRange(typeCode, emissionLevel);
    return 1.0 - smoothstep(
        range * VPT_LOCAL_FADE_START_FRACTION,
        range,
        distanceToLight
    );
}

float vptLocalLightDistanceAttenuation(float distanceToLight)
{
    return 0.55 / (1.0 + 0.18 * distanceToLight +
        0.025 * distanceToLight * distanceToLight);
}

#include "vpt_light_grid_common.glsl"

uint vliHash32(ivec3 sectionCoord)
{
    uint h = uint(sectionCoord.x) * 0x8da6b343u;
    h ^= uint(sectionCoord.y) * 0xd8163841u;
    h ^= uint(sectionCoord.z) * 0xcb1ab31fu;
    h ^= h >> 16u;
    h *= 0x7feb352du;
    h ^= h >> 15u;
    h *= 0x846ca68bu;
    h ^= h >> 16u;
    return h;
}

bool vliLookupSectionPage(ivec3 sectionCoord, out uint pageIndex)
{
    uint slot = vliHash32(sectionCoord) & (VLI_PAGE_TABLE_CAPACITY - 1u);
    for(uint probe = 0u; probe < VLI_PAGE_TABLE_CAPACITY; ++probe)
    {
        uint base = slot * 4u;
        uint pagePlusOne = vliPageTableBuffer.words[base + 3u];
        if(pagePlusOne == 0u)
        {
            pageIndex = 0u;
            return false;
        }
        if(
            int(vliPageTableBuffer.words[base + 0u]) == sectionCoord.x &&
            int(vliPageTableBuffer.words[base + 1u]) == sectionCoord.y &&
            int(vliPageTableBuffer.words[base + 2u]) == sectionCoord.z
        )
        {
            pageIndex = pagePlusOne - 1u;
            return true;
        }
        slot = (slot + 1u) & (VLI_PAGE_TABLE_CAPACITY - 1u);
    }
    pageIndex = 0u;
    return false;
}

int vliFloorDiv(int value, int divisor)
{
    return value >= 0 ? value / divisor : -((-value + divisor - 1) / divisor);
}

int vliPositiveMod(int value, int divisor)
{
    int result = value % divisor;
    return result < 0 ? result + divisor : result;
}

bool vptReadSourceVoxel(ivec3 worldBlock, out uint source)
{
    ivec3 sectionCoord = worldBlock >> 4;
    uint pageIndex;
    if(!vliLookupSectionPage(sectionCoord, pageIndex))
    {
        source = 0u;
        return false;
    }
    ivec3 local = worldBlock & 15;
    uint index = uint(local.x) + 16u * (uint(local.z) + 16u * uint(local.y));
    source = vliPagesBuffer.words[pageIndex * VLI_PAGE_WORDS + index];
    return true;
}

bool vptGridVoxelBlocked(vec3 origin, vec3 target, ivec3 targetBlock, ivec3 emitterBlock)
{
    vec3 segment = target - origin;
    float totalDist = length(segment);
    if(totalDist <= 0.05)
    {
        return false;
    }
    vec3 rayDir = segment / totalDist;
    vec3 startPos = origin + rayDir * 0.02;
    float marchLimit = totalDist - 0.04;
    if(marchLimit <= 0.02)
    {
        return false;
    }

    ivec3 cell = ivec3(floor(startPos));
    if(all(equal(cell, emitterBlock)) || all(equal(cell, targetBlock)))
    {
        return false;
    }

    ivec3 stepDir = ivec3(sign(rayDir));
    vec3 invDir = 1.0 / max(abs(rayDir), vec3(1.0e-6));
    vec3 nextBoundary = vec3(cell) + vec3(
        stepDir.x > 0 ? 1 : 0,
        stepDir.y > 0 ? 1 : 0,
        stepDir.z > 0 ? 1 : 0
    );
    vec3 tMax = vec3(
        stepDir.x != 0 ? abs(nextBoundary.x - startPos.x) * invDir.x : 1.0e30,
        stepDir.y != 0 ? abs(nextBoundary.y - startPos.y) * invDir.y : 1.0e30,
        stepDir.z != 0 ? abs(nextBoundary.z - startPos.z) * invDir.z : 1.0e30
    );

    bool memoValid = false;
    ivec3 memoSection = ivec3(0);
    uint memoPage = 0u;

    for(int iter = 0; iter < 32; ++iter)
    {
        float nextT = min(tMax.x, min(tMax.y, tMax.z));
        if(nextT >= marchLimit)
        {
            break;
        }
        if(tMax.x <= tMax.y && tMax.x <= tMax.z)
        {
            cell.x += stepDir.x;
            tMax.x += invDir.x;
        }
        else if(tMax.y <= tMax.z)
        {
            cell.y += stepDir.y;
            tMax.y += invDir.y;
        }
        else
        {
            cell.z += stepDir.z;
            tMax.z += invDir.z;
        }

        if(all(equal(cell, emitterBlock)) || all(equal(cell, targetBlock)))
        {
            break;
        }
        ivec3 sec = cell >> 4;
        if(!memoValid || any(notEqual(sec, memoSection)))
        {
            if(!vliLookupSectionPage(sec, memoPage))
            {
                return false;
            }
            memoSection = sec;
            memoValid = true;
        }
        ivec3 loc = cell & 15;
        uint vIdx = uint(loc.x) + 16u * (uint(loc.z) + 16u * uint(loc.y));
        uint source = vliPagesBuffer.words[memoPage * VLI_PAGE_WORDS + vIdx];
        if((source & 3u) == 1u)
        {
            return true;
        }
    }
    return false;
}

shared uint  s_validSecs;
shared uint  s_srcPages[125];
shared uint  s_srcCounts[125];
shared int   s_srcSecX[125];
shared int   s_srcSecY[125];
shared int   s_srcSecZ[125];
shared uint  s_count;
shared float s_minP;
shared uint  s_hasResidual;
shared uint  s_batchValid;
shared uint  s_cornerState[8];
shared int   s_blockX[64];
shared uint  s_packedYMeta[64];
shared int   s_blockZ[64];
shared float s_pCell[64];

void main()
{
    uint cellIdx = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    uint dimX = max(gridParams.x, 1u);
    uint dimY = max(gridParams.y, 1u);
    uint dimZ = max(gridParams.z, 1u);
    if(cellIdx >= VPT_LIGHT_GRID_CELLS || cellIdx >= dimX * dimY * dimZ)
    {
        return;
    }

    vec3 camPos = (cam.viewInverse * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    ivec3 gridOriginCell = ivec3(floor(camPos / 4.0)) - ivec3(
        int(dimX / 2u),
        int(dimY / 2u),
        int(dimZ / 2u)
    );
    uint livePageCount = gridParams.w;

    if(cellIdx == 0u && lane == 0u)
    {
        vptLightGridBuffer.header = uvec4(
            uint(gridOriginCell.x),
            uint(gridOriginCell.y),
            uint(gridOriginCell.z),
            (livePageCount > 0u) ? 1u : 0u
        );
    }

    uint cx = cellIdx % dimX;
    uint cz = (cellIdx / dimX) % dimZ;
    uint cy = cellIdx / (dimX * dimZ);
    ivec3 cellCoord = gridOriginCell + ivec3(int(cx), int(cy), int(cz));
    vec3 cellMin = vec3(cellCoord) * 4.0;
    vec3 cellMax = cellMin + vec3(4.0);
    vec3 padMin = cellMin - vec3(0.5);
    vec3 padMax = cellMax + vec3(0.5);

    s_pCell[lane] = -1.0;
    s_pCell[32u + lane] = -1.0;
    if(lane < 8u)
    {
        ivec3 cBlock = cellCoord * 4 + ivec3(
            ((lane & 1u) != 0u) ? 3 : 0,
            ((lane & 2u) != 0u) ? 3 : 0,
            ((lane & 4u) != 0u) ? 3 : 0
        );
        uint cSrc = 0u;
        s_cornerState[lane] = !vptReadSourceVoxel(cBlock, cSrc)
            ? 2u
            : (((cSrc & 3u) == 1u) ? 0u : 1u);
    }

    if(lane == 0u)
    {
        s_validSecs = 0u;
        s_count = 0u;
        s_minP = 0.0;
        s_hasResidual = 0u;
        s_batchValid = 0u;
    }

    barrier();

    ivec3 secMin = ivec3(floor((padMin - vec3(VPT_LOCAL_MAX_DISTANCE)) / 16.0));
    ivec3 secMax = ivec3(floor((padMax + vec3(VPT_LOCAL_MAX_DISTANCE)) / 16.0));
    ivec3 secSpan = clamp(secMax - secMin + ivec3(1), ivec3(1), ivec3(7));
    uint spanX = uint(secSpan.x);
    uint spanXZ = spanX * uint(secSpan.z);
    uint totalSecs = spanXZ * uint(secSpan.y);

    for(uint idx = lane; idx < totalSecs && livePageCount > 0u; idx += 32u)
    {
        uint sx = idx % spanX;
        uint sz = (idx / spanX) % uint(secSpan.z);
        uint sy = idx / spanXZ;
        ivec3 srcSection = secMin + ivec3(int(sx), int(sy), int(sz));
        vec3 secMinW = vec3(srcSection) * 16.0;
        vec3 secMaxW = secMinW + vec3(16.0);
        vec3 boxDelta = max(max(padMin - secMaxW, secMinW - padMax), vec3(0.0));
        if(dot(boxDelta, boxDelta) >= VPT_LOCAL_MAX_DISTANCE * VPT_LOCAL_MAX_DISTANCE)
        {
            continue;
        }
        uint pageIndex = 0u;
        if(!vliLookupSectionPage(srcSection, pageIndex))
        {
            continue;
        }
        uint ec = min(
            vptEmitterIndexPagesBuffer.words[pageIndex * VPT_EMITTER_PAGE_WORDS],
            VLI_SOURCE_WORDS
        );
        if(ec > 0u)
        {
            uint dst = atomicAdd(s_validSecs, 1u);
            if(dst < 125u)
            {
                s_srcPages[dst] = pageIndex;
                s_srcCounts[dst] = ec;
                s_srcSecX[dst] = srcSection.x;
                s_srcSecY[dst] = srcSection.y;
                s_srcSecZ[dst] = srcSection.z;
            }
        }
    }

    barrier();

    uint validSecCount = min(s_validSecs, 125u);
    if(validSecCount == 0u)
    {
        if(lane == 0u)
        {
            vptLightGridBuffer.cellMeta[cellIdx] = uvec4(0u);
        }
        return;
    }

    for(uint s = 0u; s < validSecCount; ++s)
    {
        uint sourcePage = s_srcPages[s];
        uint emitterCount = s_srcCounts[s];
        ivec3 srcSection = ivec3(s_srcSecX[s], s_srcSecY[s], s_srcSecZ[s]);

        for(uint eBase = 0u; eBase < emitterCount; eBase += 32u)
        {
            if(lane == 0u)
            {
                s_batchValid = 0u;
            }
            s_pCell[32u + lane] = -1.0;
            barrier();

            uint e = eBase + lane;
            if(e < emitterCount)
            {
                uint packedEmitter = vptEmitterIndexPagesBuffer.words[
                    sourcePage * VPT_EMITTER_PAGE_WORDS +
                    VPT_EMITTER_HEADER_WORDS + e
                ];
                uint emission = (packedEmitter >> 12u) & 15u;
                uint typeCode = (packedEmitter >> 16u) & 31u;
                ivec3 emitterBlock = srcSection * 16 + ivec3(
                    int(packedEmitter & 15u),
                    int((packedEmitter >> 4u) & 15u),
                    int((packedEmitter >> 8u) & 15u)
                );
                vec3 emitterCenter = vec3(emitterBlock) + vec3(0.5);
                vec3 closestInCell = clamp(emitterCenter, padMin, padMax);
                float distToCell = length(emitterCenter - closestInCell);
                float pCell = vptGridBaseWeight(
                    emitterBlock, emission, typeCode, padMin, padMax
                );
                if(pCell > 0.0)
                {
                    bool visible = true;
                    const bool dominatedByTop32 =
                        (s_count >= VPT_LIGHT_GRID_SLOTS && pCell <= s_minP);
                    if(dominatedByTop32)
                    {
                        visible = false;
                        if(distToCell == 0.0)
                        {
                            atomicOr(s_hasResidual, 1u);
                        }
                        else
                        {
                            bool hasOpenFaceFast = false;
                            for(int f = 0; f < 6; ++f)
                            {
                                ivec3 faceDir =
                                    (f == 0) ? ivec3( 1,  0,  0) :
                                    (f == 1) ? ivec3(-1,  0,  0) :
                                    (f == 2) ? ivec3( 0,  1,  0) :
                                    (f == 3) ? ivec3( 0, -1,  0) :
                                    (f == 4) ? ivec3( 0,  0,  1) :
                                               ivec3( 0,  0, -1);
                                uint adjSrc;
                                if(!vptReadSourceVoxel(emitterBlock + faceDir, adjSrc) ||
                                   (adjSrc & 3u) != 1u)
                                {
                                    hasOpenFaceFast = true;
                                    break;
                                }
                            }
                            if(hasOpenFaceFast)
                            {
                                atomicOr(s_hasResidual, 1u);
                            }
                        }
                    }
                    else if(distToCell > 0.0)
                    {
                        bool hasAnyOpenFace = false;
                        bool anyVisible = false;
                        vec3 bestTargetPt = vec3(0.0);
                        ivec3 bestTargetBlock = ivec3(0);
                        float bestTargetDistSq = 1.0e30;
                        bool hasTarget = false;

                        for(int f = 0; f < 6; ++f)
                        {
                            ivec3 faceDir =
                                (f == 0) ? ivec3( 1,  0,  0) :
                                (f == 1) ? ivec3(-1,  0,  0) :
                                (f == 2) ? ivec3( 0,  1,  0) :
                                (f == 3) ? ivec3( 0, -1,  0) :
                                (f == 4) ? ivec3( 0,  0,  1) :
                                           ivec3( 0,  0, -1);
                            ivec3 adjBlock = emitterBlock + faceDir;
                            uint adjSrc;
                            if(!vptReadSourceVoxel(adjBlock, adjSrc))
                            {
                                hasAnyOpenFace = true;
                                anyVisible = true;
                                break;
                            }
                            if((adjSrc & 3u) != 1u)
                            {
                                hasAnyOpenFace = true;
                                bool facesCell =
                                    (f == 0) ? (padMax.x > float(emitterBlock.x + 1)) :
                                    (f == 1) ? (padMin.x < float(emitterBlock.x)) :
                                    (f == 2) ? (padMax.y > float(emitterBlock.y + 1)) :
                                    (f == 3) ? (padMin.y < float(emitterBlock.y)) :
                                    (f == 4) ? (padMax.z > float(emitterBlock.z + 1)) :
                                               (padMin.z < float(emitterBlock.z));
                                if(facesCell)
                                {
                                    vec3 adjPt = vec3(adjBlock) + vec3(0.5);
                                    vec3 toCell = closestInCell - adjPt;
                                    float dSq = dot(toCell, toCell);
                                    if(dSq < bestTargetDistSq)
                                    {
                                        bestTargetDistSq = dSq;
                                        bestTargetBlock = adjBlock;
                                        bestTargetPt = adjPt;
                                        hasTarget = true;
                                    }
                                }
                            }
                        }

                        if(!hasAnyOpenFace)
                        {
                            visible = false;
                        }
                        else if(distToCell >= 0.5 && !anyVisible)
                        {
                            if(!hasTarget)
                            {
                                visible = false;
                                atomicOr(s_hasResidual, 1u);
                            }
                            else
                            {
                                int openProbes = 0;
                                vec3 insetMin = cellMin + vec3(0.5);
                                vec3 insetMax = cellMax - vec3(0.5);
                                vec3 nearestProbe = floor(clamp(closestInCell, insetMin, insetMax)) + vec3(0.5);
                                for(int p = 0; p < 9; ++p)
                                {
                                    vec3 probe = nearestProbe;
                                    if(p == 0)
                                    {
                                        uint probeSrc;
                                        if(!vptReadSourceVoxel(ivec3(floor(probe)), probeSrc))
                                        {
                                            anyVisible = true;
                                            break;
                                        }
                                        if((probeSrc & 3u) == 1u)
                                        {
                                            continue;
                                        }
                                    }
                                    else
                                    {
                                        uint cs = s_cornerState[p - 1];
                                        if(cs == 2u)
                                        {
                                            anyVisible = true;
                                            break;
                                        }
                                        if(cs == 0u)
                                        {
                                            continue;
                                        }
                                        int k = p - 1;
                                        probe = cellMin + vec3(
                                            ((k & 1) != 0) ? 3.5 : 0.5,
                                            ((k & 2) != 0) ? 3.5 : 0.5,
                                            ((k & 4) != 0) ? 3.5 : 0.5
                                        );
                                    }
                                    openProbes++;
                                    if(!vptGridVoxelBlocked(probe, bestTargetPt, bestTargetBlock, emitterBlock))
                                    {
                                        anyVisible = true;
                                        break;
                                    }
                                }
                                if(!anyVisible && openProbes >= 4)
                                {
                                    visible = false;
                                    atomicOr(s_hasResidual, 1u);
                                }
                            }
                        }
                    }

                    if(visible)
                    {
                        s_blockX[32u + lane] = emitterBlock.x;
                        s_packedYMeta[32u + lane] =
                            (uint(clamp(emitterBlock.y + 32768, 0, 65535)) & 0xffffu) |
                            (((emission << 5u) | typeCode) << 16u);
                        s_blockZ[32u + lane] = emitterBlock.z;
                        s_pCell[32u + lane] = pCell;
                        atomicAdd(s_batchValid, 1u);
                    }
                }
            }
            barrier();

            if(s_batchValid > 0u)
            {
                if(s_count + s_batchValid <= VPT_LIGHT_GRID_SLOTS)
                {
                    if(lane == 0u)
                    {
                        uint cur = s_count;
                        for(uint i = 0u; i < 32u; ++i)
                        {
                            if(s_pCell[32u + i] > 0.0)
                            {
                                s_blockX[cur] = s_blockX[32u + i];
                                s_packedYMeta[cur] = s_packedYMeta[32u + i];
                                s_blockZ[cur] = s_blockZ[32u + i];
                                s_pCell[cur] = s_pCell[32u + i];
                                cur++;
                            }
                        }
                        s_count = cur;
                        if(cur >= VPT_LIGHT_GRID_SLOTS)
                        {
                            float mp = 1.0e30;
                            for(uint i = 0u; i < VPT_LIGHT_GRID_SLOTS; ++i)
                            {
                                mp = min(mp, s_pCell[i]);
                            }
                            s_minP = (mp < 1.0e29) ? mp : 0.0;
                        }
                    }
                }
                else
                {
                    for(uint k = 2u; k <= 64u; k <<= 1u)
                    {
                        for(uint j = k >> 1u; j > 0u; j >>= 1u)
                        {
                            uint i = ((lane & ~(j - 1u)) << 1u) | (lane & (j - 1u));
                            uint ixj = i | j;
                            bool descHalf = ((i & k) == 0u);
                            float pi = s_pCell[i];
                            float pj = s_pCell[ixj];
                            bool swapNeeded = descHalf ? (pi < pj) : (pi > pj);
                            if(swapNeeded)
                            {
                                int tx = s_blockX[i];
                                s_blockX[i] = s_blockX[ixj];
                                s_blockX[ixj] = tx;
                                uint ty = s_packedYMeta[i];
                                s_packedYMeta[i] = s_packedYMeta[ixj];
                                s_packedYMeta[ixj] = ty;
                                int tz = s_blockZ[i];
                                s_blockZ[i] = s_blockZ[ixj];
                                s_blockZ[ixj] = tz;
                                s_pCell[i] = pj;
                                s_pCell[ixj] = pi;
                            }
                            barrier();
                        }
                    }

                    if(lane == 0u)
                    {
                        s_count = VPT_LIGHT_GRID_SLOTS;
                        s_minP = max(s_pCell[VPT_LIGHT_GRID_SLOTS - 1u], 0.0);
                        s_hasResidual = 1u;
                    }
                }
            }
            barrier();
        }
    }

    uint count = min(s_count, VPT_LIGHT_GRID_SLOTS);
    if(count == 0u)
    {
        if(lane == 0u)
        {
            vptLightGridBuffer.cellMeta[cellIdx] = uvec4(0u, 0u, s_hasResidual, 0u);
        }
        return;
    }

    if(lane < count)
    {
        vptLightGridBuffer.slots[cellIdx * VPT_LIGHT_GRID_SLOTS + lane] = uvec4(
            uint(s_blockX[lane]),
            s_packedYMeta[lane],
            uint(s_blockZ[lane]),
            floatBitsToUint(s_pCell[lane])
        );
    }

    barrier();

    if(lane == 0u)
    {
        float sumP = 0.0;
        float minP = 1.0e30;
        for(uint i = 0u; i < count; ++i)
        {
            float p = s_pCell[i];
            sumP += p;
            minP = min(minP, p);
        }
        if(minP >= 1.0e29)
        {
            minP = 0.0;
        }
        vptLightGridBuffer.cellMeta[cellIdx] = uvec4(
            count, floatBitsToUint(sumP), s_hasResidual, floatBitsToUint(minP)
        );
        if(count > 0u && sumP > 0.0)
        {
            // 复用共享内存后半段 [32..63]（排序与写出均已结束），实现零局部数组建 Alias 表
            uint smallTop = 0u;
            uint largeTop = 0u;
            float invAvg = float(count) / sumP;
            for(uint i = 0u; i < count; ++i)
            {
                float w = s_pCell[i];
                float pr = w * invAvg;
                s_pCell[32u + i] = pr;
                if(pr < 1.0)
                {
                    s_blockX[32u + (smallTop++)] = int(i);
                }
                else
                {
                    s_packedYMeta[32u + (largeTop++)] = i;
                }
            }
            while(smallTop > 0u && largeTop > 0u)
            {
                uint l = uint(s_blockX[32u + (--smallTop)]);
                uint g = s_packedYMeta[32u + (--largeTop)];
                uint thresh = clamp(uint(round(clamp(s_pCell[32u + l], 0.0, 1.0) * 65535.0)), 0u, 65535u);
                vptLightGridBuffer.aliasWords[cellIdx * VPT_LIGHT_GRID_SLOTS + l] =
                    thresh | (g << 16u);
                float newProbG = (s_pCell[32u + g] + s_pCell[32u + l]) - 1.0;
                s_pCell[32u + g] = newProbG;
                if(newProbG < 1.0)
                {
                    s_blockX[32u + (smallTop++)] = int(g);
                }
                else
                {
                    s_packedYMeta[32u + (largeTop++)] = g;
                }
            }
            while(largeTop > 0u)
            {
                uint g = s_packedYMeta[32u + (--largeTop)];
                vptLightGridBuffer.aliasWords[cellIdx * VPT_LIGHT_GRID_SLOTS + g] =
                    65535u | (g << 16u);
            }
            while(smallTop > 0u)
            {
                uint l = uint(s_blockX[32u + (--smallTop)]);
                vptLightGridBuffer.aliasWords[cellIdx * VPT_LIGHT_GRID_SLOTS + l] =
                    65535u | (l << 16u);
            }
        }
    }
}
