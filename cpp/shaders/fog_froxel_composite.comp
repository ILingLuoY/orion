#version 460
#extension GL_GOOGLE_include_directive : require

// ===========================================================================
// Volumetric Fog & Volumetric Light — Pass 3/4: 3D Front-to-Back Accumulation
//
// Dispatched as a 2D grid (froxelW x froxelH). Walks front-to-back along Z
// integrating each segment analytically (Frostbite / Wronski energy-conserving
// scattering integration) and writes the cumulative (inScatter.rgb, transmittance)
// into a 3D LUT (binding 27).
//
// Texel 0     = (0, 0, 0, 1)  at distance 0
// Texel s + 1 = integral [0, d((s + 1) / (N - 1))]
// ===========================================================================

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraProperties
{
    #include "camera_ubo.glsl"
} cam;

layout(rgba16f, set = 0, binding = 23) uniform readonly image3D fogLightRead;
layout(rgba16f, set = 0, binding = 27) uniform writeonly image3D fogIntegratedOut;

layout(push_constant) uniform FogFroxelPush
{
    vec4 params; // x = layers, y = maxDistance, z = unused, w = unused
} pc;

#include "fog_froxel_common.glsl"

const float FOG_ACCUM_CLAMP = 12.0;

void main()
{
    const ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    const ivec3 size = imageSize(fogIntegratedOut);
    if(xy.x >= size.x || xy.y >= size.y)
    {
        return;
    }

    const int layers = min(max(int(pc.params.x + 0.5), 2), size.z);
    const int segmentCount = layers - 1;
    const float maxDistance = max(pc.params.y > 1.0 ? pc.params.y : cam.cloudParams8.w, 16.0);
    const float startDistance = clamp(cam.cloudParams9.x, 0.0, maxDistance);

    // Slice 0 = distance 0 -> exact neutral (no scatter, full transmittance).
    imageStore(fogIntegratedOut, ivec3(xy, 0), vec4(0.0, 0.0, 0.0, 1.0));

    if(cam.cloudParams7.x < 0.5 || cam.waterSimState.w != 0u)
    {
        for(int s = 0; s < segmentCount; ++s)
        {
            imageStore(fogIntegratedOut, ivec3(xy, s + 1), vec4(0.0, 0.0, 0.0, 1.0));
        }
        return;
    }

    vec3 accumScatter = vec3(0.0);
    float accumTransmittance = 1.0;

    for(int s = 0; s < segmentCount; ++s)
    {
        const float d0 = fogSliceBoundaryDistance(s, layers, maxDistance);
        const float d1 = fogSliceBoundaryDistance(s + 1, layers, maxDistance);
        const float segStart = max(d0, startDistance);
        const float segEnd = max(d1, segStart);
        const float segLength = segEnd - segStart;

        if(segLength > 1.0e-5 && accumTransmittance > 1.0e-4)
        {
            vec4 cell = imageLoad(fogLightRead, ivec3(xy, s));
            if(cell.a > 1.0e-6 || dot(cell.rgb, vec3(1.0)) > 1.0e-6)
            {
                const float centerLum = dot(cell.rgb, vec3(0.2126, 0.7152, 0.0722));
                const float centerSigma = cell.a;
                vec4 sum = cell * 0.56;
                float wSum = 0.56;
                const ivec2 offsets[4] = ivec2[4](
                    ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
                for(int n = 0; n < 4; ++n)
                {
                    const ivec2 nxy = clamp(xy + offsets[n], ivec2(0), size.xy - ivec2(1));
                    const vec4 ncell = imageLoad(fogLightRead, ivec3(nxy, s));
                    if(ncell.a <= 1.0e-6)
                    {
                        continue;
                    }
                    const float nLum = dot(ncell.rgb, vec3(0.2126, 0.7152, 0.0722));
                    const float lumDiff = abs(nLum - centerLum);
                    const float lumScale = max(min(centerLum, nLum) * 1.5 + 0.015, 0.015);
                    const float sigDiff = abs(ncell.a - centerSigma) / max(centerSigma + 0.01, 0.01);
                    const float w = 0.11 * exp(-sigDiff * 3.5 - lumDiff / lumScale);
                    sum += ncell * w;
                    wSum += w;
                }
                cell = sum / max(wSum, 1.0e-4);
            }
            const vec3 inScatter = max(cell.rgb, vec3(0.0));
            const float sigmaT = max(cell.a, 0.0);

            if(sigmaT > 1.0e-6)
            {
                const float sliceT = exp(-sigmaT * segLength);
                const vec3 sliceScatter = inScatter * ((1.0 - sliceT) / sigmaT);
                accumScatter += accumTransmittance * sliceScatter;
                accumTransmittance *= sliceT;
            }
            else if(dot(inScatter, vec3(1.0)) > 1.0e-7)
            {
                // Pure in-scattering limit as sigmaT -> 0: (1 - exp(-sigmaT*L)) / sigmaT -> L
                accumScatter += accumTransmittance * (inScatter * segLength);
            }
        }

        const vec3 safeScatter = clamp(accumScatter, vec3(0.0), vec3(FOG_ACCUM_CLAMP));
        const float safeT = clamp(accumTransmittance, 0.0, 1.0);
        imageStore(fogIntegratedOut, ivec3(xy, s + 1), vec4(safeScatter, safeT));
    }
}
