#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// ============================================================================
// 2026-11-26：HDR 显示路径改走与 SDR **同一条**后处理链 + 高光延伸
//
// 2026-11-23 版的问题（HDR 观感与 SDR 脱节的根因）：
//   这里是 `曝光 → 硬软肩 → clamp → Rec2020 → PQ`，完全绕开了 rr_post_common.glsl：
//     · 色调映射模式 / 对比度 / 饱和度 / gamma / 曝光补偿以外的整条色轮全部不生效；
//     · 场景线性 >= 1（云、受光白块、雪、自发光、水面太阳耀斑）直接落到
//       279 ~ 900 nits，而同一点在 SDR 路径上已被 Uchimura / AgX 等压回 232/255
//       （约 190 ~ 210 nits）。也就是说 HDR 只把高光放大了 1.5 ~ 4 倍，
//       中间调却和 SDR 一样亮 ⇒ 看起来就是"开 HDR 整体过曝 / 白块刺眼"。
//
// 现在：
//   · 中间调与调色：直接复用 rr_post_common.glsl 的 rrPostDisplayColor()
//     （曝光 → tone map → gamma → 饱和度 → 色轮），再把 gamma 编码逆回显示线性。
//     HDR 下 0 ~ 参考白这一段与 SDR 逐像素同观感（同样的曲线、同样的色轮）。
//   · 高光延伸：tone map 已经把高光压平，这里按"曝光后线性值超过
//     HDR_SHOULDER_KNEE_REL 的量"重新加回显示线性余量，渐近到
//     HDR_PEAK_NITS / HDR_REFERENCE_WHITE_NITS。中间调不受影响，只有原本
//     在 SDR 里被压平的高光在 HDR 上重新获得层次。
//   · -DHDR_SHARED_TONEMAP=0 回退到 2026-11-23 版（编译期 A/B）。
// ============================================================================

#ifndef HDR_REFERENCE_WHITE_NITS
#define HDR_REFERENCE_WHITE_NITS 203.0
#endif

#ifndef HDR_PEAK_NITS
#define HDR_PEAK_NITS 1000.0
#endif

#ifndef HDR_SHARED_TONEMAP
#define HDR_SHARED_TONEMAP 1
#endif

// 相对参考白的肩部起点：1.0 = 超过"SDR 白点"才开始压缩。
#ifndef HDR_SHOULDER_KNEE_REL
#define HDR_SHOULDER_KNEE_REL 1.0
#endif

#ifndef HDR_HIGHLIGHT_EXTENSION
#define HDR_HIGHLIGHT_EXTENSION 1
#endif

#if HDR_SHARED_TONEMAP
#include "rr_post_common.glsl"
#endif

// 注意 GLSL mat3(vec3, vec3, vec3) 是**按列**构造，下面三行正好是 709→2020
// 矩阵的三个列向量（与旧版 rr_hdr_encode 逐位一致）。
const mat3 REC709_TO_REC2020 = mat3(
    0.6274040, 0.0690970, 0.0163916,
    0.3292820, 0.9195400, 0.0880132,
    0.0433136, 0.0113612, 0.8955950
);

const float PQ_M1 = 0.1593017578125;
const float PQ_M2 = 78.84375;
const float PQ_C1 = 0.8359375;
const float PQ_C2 = 18.8515625;
const float PQ_C3 = 18.6875;
const float PQ_PEAK_NITS = 10000.0;

vec3 encodePQ(vec3 linearNits)
{
    vec3 y =
        clamp(
            linearNits / PQ_PEAK_NITS,
            vec3(0.0),
            vec3(1.0)
        );

    vec3 n =
        pow(y, vec3(PQ_M1));

    return pow(
        (vec3(PQ_C1) + PQ_C2 * n) /
            (vec3(1.0) + PQ_C3 * n),
        vec3(PQ_M2)
    );
}

#if HDR_SHARED_TONEMAP
void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(rrOutputImage);

    if(p.x >= size.x || p.y >= size.y)
    {
        return;
    }

    vec4 color = imageLoad(rrOutputImage, p);

    // 1) 与 SDR 完全相同的链路，拿到 gamma 空间的显示色。
    vec3 exposedLinear;
    vec3 displayColor = rrPostDisplayColor(color, p, size, exposedLinear);

    displayColor = clamp(displayColor, vec3(0.0), vec3(1.0));

    // 2) 逆 gamma 回到显示线性（0 = 黑，1 = 参考白）。
    //    SDR 路径的饱和度 / 色轮都是在 gamma 空间做的，逆变换后才是真正的显示线性，
    //    不能在 gamma 空间上直接乘 nits。
    vec3 displayLinear =
        pow(displayColor, vec3(max(postPush.gamma, 1.0e-3)));

#if HDR_HIGHLIGHT_EXTENSION
    // 3) 高光延伸（逐通道）。
    //    exposedLinear 是 tone map **之前**的线性值，只有它还保留着高光的相对层次；
    //    超过 knee 的部分用 Reinhard 型曲线渐近到 (peakRel - 1) 的额外余量。
    //    base(∞) = 1，extra(∞) = peakRel - 1 ⇒ 合计上限正好是 peakRel。
    {
        const float peakRel =
            HDR_PEAK_NITS / HDR_REFERENCE_WHITE_NITS;
        const float knee = max(HDR_SHOULDER_KNEE_REL, 1.0e-3);
        const float span = max(peakRel - knee, 1.0e-3);

        vec3 over = max(exposedLinear - vec3(knee), vec3(0.0));
        vec3 extra = span * over / (over + vec3(span));

        displayLinear += extra;
    }
#endif

    displayLinear =
        min(
            displayLinear,
            vec3(PQ_PEAK_NITS / HDR_REFERENCE_WHITE_NITS)
        );

    vec3 rec2020 =
        REC709_TO_REC2020 * displayLinear;

    vec3 encoded =
        encodePQ(
            rec2020 * HDR_REFERENCE_WHITE_NITS
        );

    imageStore(
        rrOutputImage,
        p,
        vec4(encoded, color.a)
    );
}
#else

#ifndef HDR_SHOULDER_ENABLED
#define HDR_SHOULDER_ENABLED 1
#endif

#ifndef RR_STABLE_GLASS_RADIANCE
#define RR_STABLE_GLASS_RADIANCE 0
#endif

// 与 rr_sdr_post.comp / OrionInternal.h 的 PostProcessingPush 逐字节一致。
// display 派发对 HDR / SDR 是同一份 push 数据，这里只读其中几个 lane。
layout(push_constant) uniform PostPush
{
    int tonemapMode;
    float exposureStrength;
    float contrast;
    float saturation;
    float gamma;
    float gainR;
    float gainG;
    float gainB;

    float manualEV;
    float blackPoint;
    float whitePoint;
    float gradeContrast;
    float gradePivot;
    float liftR;
    float liftG;
    float liftB;
    float gradeGammaR;
    float gradeGammaG;
    float gradeGammaB;
    float gradeGainR;
    float gradeGainG;
    float gradeGainB;
    float shadowHue;
    float shadowStrength;
    float highlightHue;
    float highlightStrength;
    float vibrance;
    float fade;
    float vignette;
    float vignetteRadius;
    float hueRotate;
    float tintGreen;
} postPush;

layout(binding = 0, set = 0, rgba16f)
uniform image2D rrOutputImage;

#if RR_STABLE_GLASS_RADIANCE
layout(binding = 2, set = 0)
uniform sampler2D rrStableRadianceImage;
#endif

layout(binding = 1, set = 0)
buffer AeState
{
    float currentEV;

    float targetEV;
    float avgLogLuma;
    uint sampleCount;

    float cloudWhite;
};

// 软膝肩部：x <= knee 时输出 x（一阶连续、斜率 1）；
// x → ∞ 时渐近 peak。用来把"场景线性白 > 1"的部分收进显示域。
vec3 hdrShoulder(vec3 x, float knee, float peak)
{
    float span = max(peak - knee, 1.0e-3);
    vec3 over = max(x - vec3(knee), vec3(0.0));

    return min(x, vec3(knee)) + span * over / (over + vec3(span));
}

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(rrOutputImage);

    if(p.x >= size.x || p.y >= size.y)
    {
        return;
    }

    vec4 color = imageLoad(rrOutputImage, p);

    vec3 linear =
        max(
            mix(color.rgb, vec3(0.0), isnan(color.rgb)),
            vec3(0.0)
        );

    linear =
        mix(linear, vec3(0.0), isinf(linear));

#if RR_STABLE_GLASS_RADIANCE
#ifndef POST_SKIP_STABLE
#define POST_SKIP_STABLE 0
#endif
#if !POST_SKIP_STABLE
    vec3 stableRadiance =
        (textureSize(rrStableRadianceImage, 0) == size)
            ? texelFetch(rrStableRadianceImage, p, 0).rgb
            : texture(
                  rrStableRadianceImage,
                  (vec2(p) + vec2(0.5)) / vec2(size)
              ).rgb;

    linear +=
        max(
            mix(
                stableRadiance,
                vec3(0.0),
                isnan(stableRadiance)
            ),
            vec3(0.0)
        );
#endif
#endif

    // 曝光与 SDR 同口径，只是强度由 UI/宿主推送（默认 0.6，与旧常量一致）。
    linear *=
        exp2(currentEV * postPush.exposureStrength);

    linear *=
        vec3(postPush.gainR, postPush.gainG, postPush.gainB);

    linear *=
        exp2(postPush.manualEV);

#if HDR_SHOULDER_ENABLED
    {
        const float peakRel =
            HDR_PEAK_NITS / HDR_REFERENCE_WHITE_NITS;

        linear =
            hdrShoulder(
                linear,
                HDR_SHOULDER_KNEE_REL,
                peakRel);
    }
#endif

    linear =
        min(
            linear,
            vec3(PQ_PEAK_NITS / HDR_REFERENCE_WHITE_NITS)
        );

    vec3 rec2020 =
        REC709_TO_REC2020 * linear;

    vec3 encoded =
        encodePQ(
            rec2020 * HDR_REFERENCE_WHITE_NITS
        );

    imageStore(
        rrOutputImage,
        p,
        vec4(encoded, color.a)
    );
}
#endif
